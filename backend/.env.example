# Copy file nay thanh ".env" và để trong thư mục /backend (khong commit .env len git)
DATABASE_URL=postgresql://agritrace:agritrace_pass@db:5432/agritrace_farm

# ==============================================================================
# CẤU HÌNH GỬI MÃ XÁC THỰC OTP QUA SMS
# ==============================================================================
# Quản lý gửi SMS OTP: console (in ra terminal cho dev/test) | twilio | esms | speedsms
SMS_PROVIDER=esms

# Đặt là false khi gửi SMS thật để app không tự điền mã demo:
PASSWORD_RESET_DEMO_ENABLED=false

OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Cấu hình 1: Twilio (Cổng SMS Quốc tế & Việt Nam, có gói Free Trial để test gửi SMS thật)
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM_NUMBER=

## Cấu hình 2: eSMS.vn (Cổng SMS Việt Nam)
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=Baotrixemay
ESMS_SMS_TYPE=2

# Cấu hình 3: SpeedSMS.vn (Cổng SMS Việt Nam)
SPEEDSMS_ACCESS_TOKEN=

# ==============================================================================
# BẢO MẬT JWT & TÀI KHOẢN
# ==============================================================================
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

MAX_FAILED_LOGIN_ATTEMPTS=
LOCKOUT_MINUTES=

# Cấu hình Google AI Studio (Gemini) cho tính năng Voice-to-Text khi ghi nhật ký canh tác
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
