{
  "name": "AgriFarm",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "1.48.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.5.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^16.5.0",
    "jsqr": "1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0"
  },
  "scripts": {
    "start": "expo start --go --port 8083",
    "dev": "node start_dev.cjs",
    "mobile": "expo start --go --port 8083",
    "mobile:web": "expo start --web --port 8083",
    "mobile:build": "expo export --platform android --output-dir dist/mobile",
    "mobile:typecheck": "tsc --noEmit -p tsconfig.json",
    "mobile:lint": "eslint src --ignore-pattern \"src/(website)/**\" --ignore-pattern \"**/*_wb.*\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node start_dev.cjs --web-only",
    "webs": "npm run web",
    "web:build": "npm run owner:build && npm run admin:build",
    "web:lint": "eslint \"src/**/*_wb.{ts,tsx}\" vite.config.mts",
    "web:preview": "vite preview --config vite.config.mts",
    "build": "npm run web:build",
    "lint": "npm run mobile:lint && npm run web:lint",
    "owner:install": "npm ci",
    "owner:dev": "npm run web",
    "owner:build": "tsc --noEmit -p tsconfig.web.json && vite build --config vite.config.mts",
    "owner:lint": "npm run web:lint",
    "admin:dev": "vite --config vite.config.mts --mode admin --port 5174 --open /admin.html",
    "admin:build": "vite build --config vite.config.mts --mode admin"
  },
  "private": true
}
