{
  "name": "AgriFarm",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^58.0.22",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.29",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "1.48.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.5.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^16.5.0",
    "jsqr": "1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0"
  },
  "scripts": {
    "start": "expo start --go --port 8083",
    "dev": "node start_dev.cjs",
    "mobile": "expo start --go --port 8083",
    "mobile:web": "expo start --web --port 8083",
    "mobile:build": "expo export --platform android --output-dir dist/mobile",
    "mobile:typecheck": "tsc --noEmit -p tsconfig.json",
    "mobile:lint": "eslint src --ignore-pattern \"src/(website)/**\" --ignore-pattern \"**/*_wb.*\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node start_dev.cjs --web-only",
    "webs": "npm run web",
    "web:build": "npm run owner:build && npm run admin:build",
    "web:lint": "eslint \"src/**/*_wb.{ts,tsx}\" vite.config.mts",
    "web:preview": "vite preview --config vite.config.mts",
    "build": "npm run web:build",
    "lint": "npm run mobile:lint && npm run web:lint",
    "owner:install": "npm ci",
    "owner:dev": "npm run web",
    "owner:build": "tsc --noEmit -p tsconfig.web.json && vite build --config vite.config.mts",
    "owner:lint": "npm run web:lint",
    "admin:dev": "npm run web",
    "admin:build": "tsc --noEmit -p tsconfig.web.json && vite build --config vite.config.mts --mode admin"
  },
  "private": true
}
